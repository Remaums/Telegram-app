# Token du bot fourni par @BotFather
BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ

# URL publique HTTPS de la Mini App (obligatoire pour Telegram).
# En local : utilise un tunnel (ngrok, cloudflared) et colle l'URL https ici.
WEBAPP_URL=https://ton-domaine.exemple.com

# Chat/canal qui reçoit les nouvelles commandes (ton ID perso ou un groupe).
# Pour trouver ton ID : envoie /start au bot, il te l'affiche.
ADMIN_CHAT_ID=123456789

# Port du serveur HTTP
PORT=3000

# Devise affichée dans la boutique
CURRENCY=EUR

# Nom de la boutique
SHOP_NAME=COFFEE SHOP 68

# Ton compte Telegram perso, SANS le @ : c'est vers cette conversation que le
# bouton "Commander" redirige, avec le récapitulatif déjà écrit dans le champ texte.
SELLER_USERNAME=tonpseudo

# Identifiants Telegram autorisés à ouvrir l'espace admin (séparés par des virgules).
# Si vide, ADMIN_CHAT_ID est utilisé. Envoie /start au bot pour connaître ton ID.
ADMIN_IDS=123456789

# ── Mise en ligne (Vercel + Postgres) ────────────────────────
# Laisse ces deux variables vides en local : la boutique retombe alors sur
# les fichiers JSON de server/data/ et sur le long polling du bot.

# Postgres (Neon, Supabase, Vercel Postgres…). Utilise la chaîne « pooled »
# du fournisseur : en serverless, chaque requête ouvre sa propre connexion.
DATABASE_URL=postgres://user:motdepasse@host/db?sslmode=require

# Jeton partagé avec Telegram pour signer les appels du webhook.
# Génère-le au hasard : openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
